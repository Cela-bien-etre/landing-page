---
// Motif rond doré décoratif, positionné dans un coin de la section parente.
// Ne s'affiche que si l'image `ornement` est renseignée.
import { images, cld } from '../../data/images';

interface Props {
  position?: 'top-right' | 'top-left' | 'bottom-right' | 'bottom-left';
}

const { position = 'top-right' } = Astro.props;
---

{images.ornement && <img src={cld(images.ornement, 140)} alt="" aria-hidden="true" loading="lazy" class:list={['ornement', position]} />}

<style>
  .ornement {
    position: absolute;
    width: 64px;
    height: 64px;
    opacity: 0.8;
    pointer-events: none;
  }
  .top-right { top: 2rem; right: 2rem; }
  .top-left { top: 2rem; left: 2rem; }
  .bottom-right { bottom: 2rem; right: 2rem; }
  .bottom-left { bottom: 2rem; left: 2rem; }

  @media (max-width: 700px) {
    .ornement { width: 44px; height: 44px; }
    .top-right, .top-left { top: 1rem; }
    .bottom-right, .bottom-left { bottom: 1rem; }
    .top-right, .bottom-right { right: 1rem; }
    .top-left, .bottom-left { left: 1rem; }
  }
</style>
