---
import '../styles/Retraites.css';
import { images } from '../data/images';
import { getLang, useTranslations } from '../i18n';
import Photo from './ui/Photo.astro';
import Ornement from './ui/Ornement.astro';

const t = useTranslations(getLang(Astro.currentLocale));
---

<section id="retraites" class="section">
  <div class="container retraites">
    <div class="retraites-text">
      <h2 class="section-title">{t.retraites.title}</h2>
      {t.retraites.paragraphs.map((p) => <p>{p}</p>)}
      <p class="retraites-note">{t.retraites.note}</p>
      <a href="#contact" class="button retraites-button">{t.retraites.contact}</a>
    </div>
    <div class="retraites-photo">
      <Photo src={images.retraiteYoga} alt={t.retraites.photoAlt} width={600} />
    </div>
  </div>
  <Ornement position="bottom-left" />
</section>
