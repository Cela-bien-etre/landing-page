---
import '../styles/Formules.css';
import { images } from '../data/images';
import { getLang, useTranslations } from '../i18n';
import Photo from './ui/Photo.astro';
import Ornement from './ui/Ornement.astro';

const t = useTranslations(getLang(Astro.currentLocale));

const formules = [
  { href: '#soins', image: images.formuleDomicile, label: t.formules.domicile },
  { href: '#jeune', image: images.formuleJeune, label: t.formules.jeune },
  { href: '#retraites', image: images.formuleYoga, label: t.formules.yoga },
];
---

<section id="formules" class="section">
  <Ornement />
  <div class="container">
    <h2 class="section-title">{t.formules.title}</h2>
    <div class="formules-grid">
      {
        formules.map((f) => (
          <a href={f.href} class="formule-card">
            <Photo src={f.image} alt="" width={600} />
            <span class="formule-label">{f.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
