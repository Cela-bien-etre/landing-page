---
import '../styles/Avis.css';
import { images } from '../data/images';
import { avis } from '../data/avis';
import { site } from '../data/site';
import { getLang, useTranslations, fill } from '../i18n';
import Photo from './ui/Photo.astro';
import Ornement from './ui/Ornement.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const [prestations1, prestations2] = t.avis.prestationsTexte;
---

<section id="avis" class="section">
  <div class="container avis-layout">
    <div class="prestations">
      <Photo src={images.prestations} alt="" width={800} class="prestations-bg" />
      <div class="prestations-content">
        <p>
          {prestations1}<br />
          {prestations2}
        </p>
        {t.avis.prestationsTitle && <h2 class="prestations-title">{t.avis.prestationsTitle}</h2>}
        <a
          href={site.planityUrl || undefined}
          class="button button--light"
          target="_blank"
          rel="noopener noreferrer"
          aria-disabled={site.planityUrl ? undefined : 'true'}
        >
          {t.common.bookPlanity}<span class="sr-only">{t.common.newTab}</span>
        </a>
      </div>
    </div>

    <div class="avis">
      <h2 class="avis-title">{t.avis.title}</h2>
      <ul class="avis-list">
        {
          avis.map((a) => (
            <li class="avis-card">
              <blockquote>
                <p class="avis-header">
                  <strong>{a.nom}</strong> <span>• {t.avis.client}</span>
                  {a.langueOriginale !== lang && <span class="avis-traduit">({t.avis.traduit})</span>}
                </p>
                <p class="avis-texte">{t.avis.items[a.id]}</p>
              </blockquote>
              <p class="avis-note">
                <span aria-hidden="true">★ {a.note.toFixed(1)}</span>
                <span class="sr-only">{fill(t.avis.note, { note: a.note })}</span>
              </p>
            </li>
          ))
        }
      </ul>
      {
        site.googleBusinessUrl && (
          <p class="avis-google">
            <a href={site.googleBusinessUrl} class="button" target="_blank" rel="noopener noreferrer">
              {t.avis.google}<span class="sr-only">{t.common.newTab}</span>
            </a>
          </p>
        )
      }
    </div>
  </div>
  <Ornement position="bottom-right" />
</section>
