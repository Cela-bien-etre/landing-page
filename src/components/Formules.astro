---
import '../styles/Formules.css';
import { images } from '../data/images';
import Photo from './ui/Photo.astro';
import Ornement from './ui/Ornement.astro';

const formules = [
  { href: '#soins', image: images.formuleDomicile, label: 'À votre domicile, dans votre cocon de douceur' },
  { href: '#jeune', image: images.formuleJeune, label: "Dans le cadre d'un séjour de Jeûne & Randonnée" },
  { href: '#retraites', image: images.formuleYoga, label: "Lors d'une retraite de Yoga & Méditation" },
];
---

<section id="formules" class="section">
  <Ornement />
  <div class="container">
    <h2 class="section-title">Vous pouvez faire appel à moi :</h2>
    <div class="formules-grid">
      {
        formules.map((f) => (
          <a href={f.href} class="formule-card">
            <Photo src={f.image} alt="" width={600} />
            <span class="formule-label">{f.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
