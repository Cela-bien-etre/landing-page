---
import '../styles/Hero.css';
import { images, cld, heroImages } from '../data/images';
import { site } from '../data/site';

const heroStyle = heroImages
  ? `--hero-bg: url(${heroImages.desktop}); --hero-bg-mobile: url(${heroImages.mobile})`
  : '--hero-bg: none; --hero-bg-mobile: none';
---

<header id="hero" style={heroStyle}>
  <a href="/" class="hero-logo">
    {
      images.logo ? (
        <img src={cld(images.logo, 400)} alt={site.name} loading="eager" />
      ) : (
        <span class="hero-logo-text">
          Céla <small>Bien-être</small>
        </span>
      )
    }
  </a>

  <div class="hero-content">
    {images.ornement && <img src={cld(images.ornement, 140)} alt="" aria-hidden="true" class="hero-ornement" />}
    <h1>Massages à domicile <span class="hero-lieu">à {site.city} & alentours</span></h1>
    <p class="hero-soins">Personnalisé - Deep tissue - Sportif - Réflexologie plantaire - Kobido - Reiki</p>
    <span class="hero-separator" aria-hidden="true"></span>
    <blockquote>
      <p>« La meilleure façon de se reconnecter à Soi est de toucher le corps avec l'intention de l'écouter avec le cœur. »</p>
      <cite>{site.owner}</cite>
    </blockquote>
    <div class="hero-actions">
      <a href="#contact" class="button button--light" lang="en">Let's connect</a>
      {
        site.planityUrl && (
          <a href={site.planityUrl} class="button" target="_blank" rel="noopener noreferrer">
            Réserver sur Planity<span class="sr-only"> (nouvel onglet)</span>
          </a>
        )
      }
    </div>
  </div>
</header>
