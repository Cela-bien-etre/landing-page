---
import '../styles/Hero.css';
import { images, cld, heroImages } from '../data/images';
import { site } from '../data/site';
import { getLang, useTranslations, fill, routes } from '../i18n';
import LangSwitch from './ui/LangSwitch.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const heroStyle = heroImages
  ? `--hero-bg: url(${heroImages.desktop}); --hero-bg-mobile: url(${heroImages.mobile})`
  : '--hero-bg: none; --hero-bg-mobile: none';
---

<header id="hero" style={heroStyle}>
  <a href={routes.home[lang]} class="hero-logo">
    {
      images.logo ? (
        <img src={cld(images.logo, 400)} alt={site.name} loading="eager" />
      ) : (
        <span class="hero-logo-text">
          Céla <small>Bien-être</small>
        </span>
      )
    }
  </a>

  <LangSwitch page="home" tone="light" class="hero-lang" />

  <div class="hero-content">
    {images.ornement && <img src={cld(images.ornement, 140)} alt="" aria-hidden="true" class="hero-ornement" />}
    <h1>{t.hero.title} <span class="hero-lieu">{fill(t.hero.location, { city: site.city })}</span></h1>
    <p class="hero-soins">{t.hero.soins}</p>
    <span class="hero-separator" aria-hidden="true"></span>
    <blockquote>
      <p>{t.hero.quote}</p>
      <cite>{site.owner}</cite>
    </blockquote>
    <div class="hero-actions">
      <a href="#contact" class="button button--light">{t.hero.contact}</a>
      {
        site.planityUrl && (
          <a href={site.planityUrl} class="button" target="_blank" rel="noopener noreferrer">
            {t.common.bookPlanity}<span class="sr-only">{t.common.newTab}</span>
          </a>
        )
      }
    </div>
  </div>
</header>
