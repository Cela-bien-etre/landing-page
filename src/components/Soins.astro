---
import '../styles/Soins.css';
import { images } from '../data/images';
import { soins } from '../data/soins';
import Photo from './ui/Photo.astro';
import Ornement from './ui/Ornement.astro';

// Les soins sont présentés par blocs de 2, avec l'image alternativement à gauche / à droite
const blocImages = [images.soins1, images.soins2, images.soins3];
const blocs = blocImages.map((image, i) => ({ image, soins: soins.slice(i * 2, i * 2 + 2) }));
---

<section id="soins" class="section">
  <Ornement />
  <div class="container">
    <h2 class="section-title section-title--center">
      Les soins à domicile :<br />
      <span class="soins-subtitle">chaque massage est adapté en fonction de vos besoins du moment</span>
    </h2>

    {
      blocs.map((bloc, i) => (
        <div class:list={['soins-bloc', { 'soins-bloc--reverse': i % 2 === 1 }]}>
          <div class="soins-photo">
            <Photo src={bloc.image} alt="Massage à domicile" width={600} />
          </div>
          <ul class="soins-list">
            {bloc.soins.map((soin) => (
              <li class="soin">
                <h3 class="soin-nom">{soin.nom}</h3>
                <p class="soin-description">{soin.description}</p>
                <ul class="soin-tarifs" aria-label={`Tarifs ${soin.nom}`}>
                  {soin.tarifs.map((t) => (
                    <li>
                      {t.duree} - {t.prix}
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
