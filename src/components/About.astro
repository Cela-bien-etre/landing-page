---
import '../styles/About.css';
import { images } from '../data/images';
import { getLang, useTranslations } from '../i18n';
import Photo from './ui/Photo.astro';

const t = useTranslations(getLang(Astro.currentLocale));
---

<section id="a-propos" class="about">
  <div class="about-text">
    <h2 class="section-title">{t.about.title}</h2>
    {t.about.paragraphs.map((p) => <p>{p}</p>)}
  </div>
  <div class="about-photo">
    <Photo src={images.portrait} alt={t.about.photoAlt} width={900} />
  </div>
</section>
