---
import '../styles/Jeune.css';
import { images } from '../data/images';
import { getLang, useTranslations, fill } from '../i18n';
import Photo from './ui/Photo.astro';
import Ornement from './ui/Ornement.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const zones = [
  { ...t.jeune.zones.dos, image: images.zoneDos },
  { ...t.jeune.zones.ventre, image: images.zoneVentre },
  { ...t.jeune.zones.tete, image: images.zoneTete },
  { ...t.jeune.zones.pieds, image: images.zonePieds },
];
const [alt1, alt2, alt3] = t.jeune.collageAlts;
---

<section id="jeune" class="section section--alt">
  <Ornement />
  <div class="container">
    <h2 class="section-title section-title--center">
      {t.jeune.title}<br />{t.jeune.subtitle}
    </h2>

    <div class="jeune-collages">
      <div class="jeune-collage"><Photo src={images.jeune1} alt={alt1} width={600} /></div>
      <div class="jeune-collage jeune-collage--center"><Photo src={images.jeune2} alt={alt2} width={700} /></div>
      <div class="jeune-collage"><Photo src={images.jeune3} alt={alt3} width={600} /></div>
    </div>

    <h3 class="title-spaced zones-title">{t.jeune.zonesTitle}</h3>
    <div class="zones-grid">
      {
        zones.map((z) => (
          <article class="zone">
            <div class="zone-photo">
              <Photo src={z.image} alt={fill(t.jeune.zonePhotoAlt, { zone: z.zone.toLocaleLowerCase(lang) })} width={500} />
            </div>
            <h4 class="zone-nom">
              <span class="zone-zone">{z.zone}</span>
              <span class="zone-etat">{z.etat}</span>
            </h4>
            {z.texte.map((p) => <p>{p}</p>)}
          </article>
        ))
      }
    </div>

    <div class="regenerant">
      <h3 class="title-spaced regenerant-title">{t.jeune.regenerantTitle}</h3>
      <div class="regenerant-content">
        <div class="regenerant-photo">
          <Photo src={images.soinRegenerant} alt={t.jeune.regenerantPhotoAlt} width={700} />
        </div>
        <div class="regenerant-text">
          <h4>{t.jeune.regenerantNom}</h4>
          {t.jeune.regenerantTexte.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </div>
  <Ornement position="bottom-right" />
</section>
