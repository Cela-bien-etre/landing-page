---
import '../styles/ToucherConscient.css';
import { getLang, useTranslations } from '../i18n';
import Ornement from './ui/Ornement.astro';

const t = useTranslations(getLang(Astro.currentLocale));
---

<section id="toucher-conscient" class="section">
  <Ornement />
  <div class="container">
    <h2 class="section-title">{t.toucher.title}</h2>
    <ul class="bienfaits">
      {t.toucher.bienfaits.map((b) => <li>{b}</li>)}
    </ul>
  </div>
</section>
