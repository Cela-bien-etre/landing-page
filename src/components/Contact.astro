---
import '../styles/Contact.css';
import { images, cld } from '../data/images';
import { site } from '../data/site';
import { getLang, useTranslations, routes } from '../i18n';
import SocialLinks from './ui/SocialLinks.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const c = t.contact;

// Téléphone : format national en français (07 …), international en anglais (+33 7 …)
const phoneHref = site.phone ? `tel:${site.phone.replace(/[^\d+]/g, '')}` : '';
const phoneLabel = lang === 'fr' ? site.phone.replace(/^\+33\s?/, '0') : site.phone;

const bg = images.contact ? `url(${cld(images.contact, 1920)})` : 'none';

// Messages affichés par le script du formulaire (dans la langue de la page)
const errors = c.errors;
const statusLabels = c.status;
---

<section id="contact" class="contact" style={`--contact-bg: ${bg}`}>
  <div class="container contact-layout">
    <div class="contact-intro">
      <h2 class="contact-title">{c.title}</h2>
      <p>{c.intro}</p>
      <div class="contact-direct">
        {site.phone && (
          <a class="contact-phone" href={phoneHref} aria-label={`${c.phone} ${phoneLabel}`}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />
            </svg>
            <span>{phoneLabel}</span>
          </a>
        )}
        <SocialLinks />
      </div>
    </div>

    <div class="contact-card">
      <!--
        Formulaire Netlify Forms.
        - Avec JavaScript : envoi en arrière-plan (fetch) et message de confirmation sur place.
        - Sans JavaScript : envoi classique, Netlify redirige vers la page de remerciement.
        Les deux langues envoient vers le même formulaire « contact » ; le champ « langue » indique la version utilisée.
      -->
      <form
        class="contact-form"
        name="contact"
        method="POST"
        action={routes.thanks[lang]}
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="langue" value={lang} />
        <p hidden><label>{c.honeypot} <input name="bot-field" /></label></p>
        <p class="form-required-note">{c.requiredNote[0]} <span class="required">*</span> {c.requiredNote[1]}</p>

        <!-- Les valeurs envoyées restent en français dans les deux langues, pour que Céline les lise facilement -->
        <fieldset class="form-group contact-profil">
          <legend>{c.profil} <span class="required" aria-hidden="true">*</span></legend>
          <div class="contact-profil-options">
            <label>
              <input type="radio" name="profil" value="Particulier" required aria-describedby="profil-error" />
              <span>{c.particulier}</span>
            </label>
            <label>
              <input type="radio" name="profil" value="Professionnel" aria-describedby="profil-error" />
              <span>{c.professionnel} <span class="optional">{c.professionnelHint}</span></span>
            </label>
          </div>
          <p class="field-error" id="profil-error" hidden></p>
        </fieldset>

        <div class="form-group">
          <label for="contact-name">{c.name} <span class="required" aria-hidden="true">*</span></label>
          <input id="contact-name" type="text" name="name" autocomplete="name" maxlength="80" required aria-describedby="name-error" />
          <p class="field-error" id="name-error" hidden></p>
        </div>

        <div class="form-group">
          <label for="contact-email">{c.email} <span class="required" aria-hidden="true">*</span></label>
          <input id="contact-email" type="email" name="email" autocomplete="email" maxlength="120" required aria-describedby="email-error" />
          <p class="field-error" id="email-error" hidden></p>
        </div>

        <div class="form-group">
          <label for="contact-phone">{c.phone} <span class="optional">{c.optional}</span></label>
          <input
            id="contact-phone"
            type="tel"
            name="phone"
            inputmode="tel"
            autocomplete="tel"
            maxlength="25"
            pattern="[0-9\s\+\(\)\.\-]{6,25}"
            aria-describedby="phone-error"
          />
          <p class="field-error" id="phone-error" hidden></p>
        </div>

        <div class="form-group">
          <label for="contact-message">{c.message} <span class="required" aria-hidden="true">*</span></label>
          <textarea id="contact-message" name="message" rows="4" maxlength="2000" required aria-describedby="message-error"></textarea>
          <p class="field-error" id="message-error" hidden></p>
        </div>

        <div class="form-group">
          <label class="contact-rgpd">
            <input type="checkbox" name="rgpd" value="oui" required aria-describedby="rgpd-error" />
            <span>{c.consent} <span class="required" aria-hidden="true">*</span></span>
          </label>
          <p class="field-error" id="rgpd-error" hidden></p>
        </div>

        <button type="submit" class="button submit-button">
          <span class="submit-label">{c.submit}</span>
          <span class="submit-spinner" aria-hidden="true"></span>
        </button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>

      <div class="form-success" role="alert" tabindex="-1" hidden>
        <span class="form-success-icon" aria-hidden="true">✓</span>
        <h3>{c.successTitle}</h3>
        <p>{c.successText} {site.owner}</p>
      </div>
    </div>
  </div>

  <div class="container contact-signature">
    <span class="contact-line" aria-hidden="true"></span>
    <span>{site.domain}</span>
  </div>
</section>

<script is:inline define:vars={{ errors, statusLabels }}>
  const form = document.querySelector('.contact-form');
  const success = document.querySelector('.form-success');

  if (form && success) {
    // JS disponible : on remplace la validation native par des messages en français sous chaque champ.
    form.setAttribute('novalidate', '');

    const statusEl = form.querySelector('.form-status');
    const button = form.querySelector('.submit-button');
    let submitted = false;

    const errorMessage = (field) => {
      if (field.name === 'rgpd') return errors.consent;
      if (field.name === 'profil') return errors.profil;
      if (field.type === 'email') return errors.email;
      if (field.type === 'tel') return errors.phone;
      if (field.name === 'message') return errors.message;
      if (field.name === 'name') return errors.name;
      return errors.invalid;
    };

    const setFieldState = (field) => {
      const id = field.getAttribute('aria-describedby');
      const errorEl = id ? document.getElementById(id) : null;
      // Boutons radio : l'état (valide ou non) s'applique à tout le groupe
      const group = field.type === 'radio' ? [...form.querySelectorAll(`input[name="${field.name}"]`)] : [field];
      if (field.checkValidity()) {
        group.forEach((f) => f.removeAttribute('aria-invalid'));
        if (errorEl) errorEl.hidden = true;
        return true;
      }
      group.forEach((f) => f.setAttribute('aria-invalid', 'true'));
      if (errorEl) {
        errorEl.textContent = errorMessage(field);
        errorEl.hidden = false;
      }
      return false;
    };

    const setStatus = (text, kind) => {
      statusEl.textContent = text || '';
      statusEl.dataset.kind = kind || '';
    };

    const fields = [...form.querySelectorAll('input[aria-describedby], textarea')];

    // Après une première tentative d'envoi, on revalide chaque champ quand il change.
    fields.forEach((field) => {
      const revalidate = () => {
        if (submitted) setFieldState(field);
      };
      field.addEventListener('blur', revalidate);
      field.addEventListener('change', revalidate);
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      submitted = true;

      let firstInvalid = null;
      fields.forEach((field) => {
        if (!setFieldState(field) && !firstInvalid) firstInvalid = field;
      });
      if (firstInvalid) {
        setStatus(errors.invalid, 'error');
        firstInvalid.focus();
        return;
      }

      button.disabled = true;
      button.classList.add('is-loading');
      setStatus(statusLabels.sending, 'sending');

      try {
        const body = new URLSearchParams(new FormData(form)).toString();
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (!response.ok) throw new Error('HTTP ' + response.status);
        form.hidden = true;
        success.hidden = false;
        success.focus();
      } catch (err) {
        setStatus(statusLabels.error, 'error');
      } finally {
        button.disabled = false;
        button.classList.remove('is-loading');
      }
    });
  }
</script>
