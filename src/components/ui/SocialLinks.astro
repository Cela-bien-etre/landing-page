---
// Icônes Instagram / Facebook (liens définis dans src/data/site.ts).
import '../../styles/SocialLinks.css';
import { site } from '../../data/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

{(site.instagram || site.facebook) && (
  <ul class:list={['social-links', className]}>
    {site.instagram && (
      <li>
        <a href={site.instagram} target="_blank" rel="noopener" aria-label={`${site.name} – Instagram`}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
          </svg>
        </a>
      </li>
    )}
    {site.facebook && (
      <li>
        <a href={site.facebook} target="_blank" rel="noopener" aria-label={`${site.name} – Facebook`}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
            <path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21h2.9z" />
          </svg>
        </a>
      </li>
    )}
  </ul>
)}
