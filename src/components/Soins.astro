---
import '../styles/Soins.css';
import { images } from '../data/images';
import { soins } from '../data/soins';
import { site } from '../data/site';
import { getLang, useTranslations, fill } from '../i18n';
import Photo from './ui/Photo.astro';
import Ornement from './ui/Ornement.astro';

const t = useTranslations(getLang(Astro.currentLocale));

// Les soins sont présentés par blocs de 2, avec l'image alternativement à gauche / à droite
const blocImages = [images.soins1, images.soins2, images.soins3];
const blocs = blocImages.map((image, i) => ({ image, soins: soins.slice(i * 2, i * 2 + 2) }));
---

<section id="soins" class="section">
  <Ornement />
  <div class="container">
    <h2 class="section-title section-title--center">
      {t.soins.title}<br />
      <span class="soins-subtitle">{t.soins.subtitle}</span>
    </h2>

    {
      blocs.map((bloc, i) => (
        <div class:list={['soins-bloc', { 'soins-bloc--reverse': i % 2 === 1 }]}>
          <div class="soins-photo">
            <Photo src={bloc.image} alt={t.soins.photoAlt} width={600} />
          </div>
          <ul class="soins-list">
            {bloc.soins.map((soin) => {
              const texte = t.soins.items[soin.id];
              return (
                <li class="soin">
                  <h3 class="soin-nom">{texte.nom}</h3>
                  <p class="soin-description">{texte.description}</p>
                  <ul class="soin-tarifs" aria-label={fill(t.soins.tarifsLabel, { soin: texte.nom })}>
                    {soin.tarifs.map((tarif) => (
                      <li>
                        {tarif.duree} - {tarif.prix}
                      </li>
                    ))}
                  </ul>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }

    {
      site.planityUrl && (
        <div class="soins-actions">
          <a href={site.planityUrl} class="button" target="_blank" rel="noopener noreferrer">
            {t.common.bookPlanity}<span class="sr-only">{t.common.newTab}</span>
          </a>
        </div>
      )
    }
  </div>
</section>
